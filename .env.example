# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริงก่อน deploy — ห้าม commit ไฟล์ .env เข้า git
# คำสั่ง: cp .env.example .env  แล้วแก้ค่าด้านล่างทั้งหมด

# --- PostgreSQL ------------------------------------------------------------
# ตั้งรหัสผ่านใหม่ทั้งหมด อย่าใช้ค่าตัวอย่างนี้ในระบบจริง (สุ่มด้วย เช่น `openssl rand -base64 24`)
PG_DATABASE=tdprinter_care
PG_USER=tdprinter
PG_PASSWORD=change_this_to_a_long_random_value_too

# --- บัญชีผู้ใช้เริ่มต้น ----------------------------------------------------
# ปิดการใส่ข้อมูลตัวอย่าง/บัญชีทดสอบ (admin1/admin123 ฯลฯ) ตอน deploy จริง
SEED_DEMO_DATA=0
# ถ้าฐานข้อมูลว่างและ SEED_DEMO_DATA=0 ระบบจะสร้างบัญชีแอดมินคนแรกจาก 2 ค่านี้ให้อัตโนมัติ
# (ตั้งรหัสผ่านที่คาดเดายากอย่างน้อย 8 ตัวอักษร แล้วลบ/คอมเมนต์ทิ้งหลังสร้างบัญชีสำเร็จแล้วก็ได้)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change_this_to_a_strong_password

# --- ความปลอดภัยของ session cookie ----------------------------------------
# ต้องเป็น 1 (ค่าเริ่มต้น) เสมอเมื่อใช้งานจริงผ่าน HTTPS — ตั้งเป็น 0 เฉพาะตอนทดสอบผ่าน http
# ธรรมดาบนเครื่อง dev เท่านั้น ถ้าตั้ง 0 บนระบบจริงจะทำให้ session cookie ถูกดักฟังได้ง่ายขึ้น
COOKIE_SECURE=1

# --- อีเมลแจ้งเตือน (Alert & Notification) — ไม่บังคับ -----------------------
# เว้นว่าง SMTP_HOST ไว้ได้ถ้ายังไม่ต้องการส่งอีเมล ระบบจะยังแจ้งเตือนในแอป (กระดิ่ง 🔔 มุมขวาบน) ตามปกติ
# ตัวอย่างการตั้งค่ากับ Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=อีเมลของคุณ,
# SMTP_PASSWORD=App Password (ต้องสร้างจาก Google Account -> Security -> App Passwords ไม่ใช่รหัสผ่านปกติ)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# ที่อยู่อีเมลผู้ส่งที่ลูกค้าจะเห็น (เว้นว่าง = ใช้ SMTP_USER)
SMTP_FROM=
# 1 = ใช้ STARTTLS (ค่าเริ่มต้น, ใช้กับ Gmail/ผู้ให้บริการทั่วไปที่พอร์ต 587) ตั้ง 0 ถ้า SMTP server ไม่รองรับ
SMTP_USE_TLS=1

# --- สมัครสมาชิก/ล็อกอินด้วย Google หรือ LINE (OAuth2) — ไม่บังคับ ---------------
# เว้นว่างไว้ได้ถ้ายังไม่ต้องการเปิดใช้งาน (ปุ่มที่หน้า /signup จะขึ้น "ยังไม่พร้อมใช้งาน" เฉยๆ)
# PUBLIC_BASE_URL ต้องตรงกับโดเมนจริงทุกตัวอักษร (รวม https://) ไม่มี / ปิดท้าย — ใช้ประกอบ redirect URI
PUBLIC_BASE_URL=https://servicepro.tdprinter.com
# Google: สร้าง OAuth Client ID (Web application) ที่ https://console.cloud.google.com/apis/credentials
# ใส่ Authorized redirect URI = {PUBLIC_BASE_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# LINE: สร้างช่องทาง "LINE Login" ที่ https://developers.line.biz/console/
# ใส่ Callback URL = {PUBLIC_BASE_URL}/auth/line/callback
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=

# --- Odoo (self-hosted) — ไม่บังคับ --------------------------------------------
# ตั้งรหัสผ่านของฐานข้อมูล Odoo เอง (คนละตัวกับ PG_PASSWORD ด้านบน — ห้ามใช้ค่าเดียวกัน)
# ต้องตั้งค่านี้เสมอถ้าจะเปิดใช้ service odoo-db/odoo ใน docker-compose.yml (สุ่มด้วย
# `openssl rand -base64 24`) ถ้าไม่ได้ใช้ Odoo เลย คอมเมนต์ service odoo-db/odoo ใน
# docker-compose.yml ออก แล้วเว้นค่านี้ว่างไว้ได้
ODOO_DB_USER=odoo
ODOO_DB_PASSWORD=change_this_to_a_long_random_value_too
# Master Password ของหน้า Database Manager Odoo (/web/database/manager) — ใช้ตอนสร้าง/ลบ/สำรอง
# ฐานข้อมูล Odoo ตั้งค่าไว้ตายตัวที่นี่ (ระบบจะเขียนเข้า odoo.conf ให้อัตโนมัติทุกครั้งที่ container
# เริ่มทำงาน — ดู odoo/entrypoint-wrapper.sh) เพื่อให้ค่าเดิมเสมอไม่ว่าจะ deploy ครั้งแรกหรือย้ายไป
# เซิร์ฟเวอร์ใหม่ก็ตาม ไม่ต้องเข้าเว็บตั้งเองรอบแรก — เปลี่ยนเป็นค่าของร้านได้ตามต้องการ
ODOO_MASTER_PASSWORD=Tong@1234
# (ไม่บังคับ) โดเมนย่อยสำหรับเข้าหน้าเว็บ Odoo ผ่าน reverse proxy เช่น odoo.tdprinter.com
# ต้องตั้ง DNS ของโดเมนย่อยนี้ให้ชี้มาที่เซิร์ฟเวอร์เดียวกันก่อน — เว้นว่างได้ถ้าจะเข้า Odoo ทาง SSH
# tunnel/port-forward ชั่วคราวแทน (ดูขั้นตอนตั้งค่าเริ่มต้นที่ DOCKER.md หัวข้อ "เชื่อมต่อ Odoo")
ODOO_VIRTUAL_HOST=

# ขั้นตอนเชื่อมแอปนี้เข้ากับ Odoo (หลังรัน `docker compose up -d odoo-db odoo` และตั้งค่าฐานข้อมูล
# Odoo ครั้งแรกผ่านหน้าเว็บเสร็จแล้ว — ดูขั้นตอนละเอียดที่ DOCKER.md หัวข้อ "เชื่อมต่อ Odoo"):
#   1) ล็อกอินเข้า Odoo -> เปิด developer mode -> Settings -> Users & Companies -> Users ->
#      เลือกผู้ใช้ที่จะใช้ซิงก์ -> แท็บ "Account Security" -> "New API Key" -> คัดลอกคีย์มาใส่
#      ODOO_API_KEY ด้านล่าง (คีย์จะแสดงครั้งเดียวตอนสร้าง เก็บไว้ให้ดี)
#   2) ODOO_DB = ชื่อฐานข้อมูลที่ตั้งตอนสร้าง Odoo ครั้งแรก (ดูได้จากหน้า Database Manager)
#   3) ODOO_USERNAME = อีเมล/ชื่อผู้ใช้ที่ใช้ล็อกอิน Odoo ของผู้ใช้ที่สร้าง API Key ในข้อ 1
#   4) ถ้าใช้ service odoo ในไฟล์นี้อยู่แล้ว ไม่ต้องตั้ง ODOO_URL (ค่าเริ่มต้น http://odoo:8069
#      ใน docker-compose.yml ใช้งานได้เลย) — ตั้งเฉพาะถ้าใช้ Odoo ที่อื่น
# เว้นว่าง ODOO_DB/ODOO_USERNAME/ODOO_API_KEY ไว้ได้ถ้ายังไม่พร้อมใช้งาน ระบบจะข้ามการซิงก์เงียบๆ
# ไม่กระทบการสร้าง/แก้ไขข้อมูลลูกค้าตามปกติ
ODOO_URL=
ODOO_DB=
ODOO_USERNAME=
ODOO_API_KEY=
